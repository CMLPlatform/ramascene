# Copy to .env and fill in; docker compose reads it from this directory.
# .env is not tracked. Other variables have defaults in docker-compose.yml.

SECRET_KEY=
# The Zenodo dataset (doi.org/10.5281/zenodo.3533196) ships files suffixed _v4.
DATASETS_VERSION=v4

# Optional: jobs each Celery worker runs at once (default 1). A scenario job
# now needs about 60 MB of its own memory; L and A are shared through the
# page cache, so this can go up to the number of free cores.
# WORKER_CONCURRENCY=4
