# Copy to .env and fill in. .env is never committed (see .gitignore).
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(50))"

COMPOSE_PROJECT_NAME=ramascene
DJANGO_SETTINGS_MODULE=ramasceneMasterProject.config.production
DEBUG=False
SECRET_KEY=
HOST=
DATABASES_DEFAULT_NAME=db.sqlite3
# Folder on the server that holds one sub folder per year (mounted read-only at /datasets)
DATASETS_DIR=
DATASETS_VERSION=v5

# Celery broker, e.g. amqp://USER:PASSWORD@message_broker:5672/VHOST
BROKER_URL=
RABBITMQ_VHOST=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Maximum number of calculation jobs queued or running at once (default 50)
RAMASCENE_MAX_ACTIVE_JOBS=50

# Memory cap for the scenario worker (a full inversion needs about 2.3 GB on top of the matrices)
MODELLING_MEM_LIMIT=6g

# Size of the dataset the matrices come from (EXIOBASE 3.11.2 industry-by-industry: 163 / 49; the older 3.3 product-by-product data: 200 / 49)
DATASET_N_PRODUCTS=163
DATASET_N_COUNTRIES=49
