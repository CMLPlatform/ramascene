# Copy to .env and fill in. .env is never committed (see .gitignore).
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(50))"

COMPOSE_PROJECT_NAME=ramascene
DJANGO_SETTINGS_MODULE=ramasceneMasterProject.config.production
DEBUG=False
SECRET_KEY=
DATABASE_NAME=db.sqlite3
DATASETS_VERSION=v4

RABBITMQ_VHOST=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
