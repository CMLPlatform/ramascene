# Copy to .env and fill in. .env is never committed (see .gitignore).
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(50))"

COMPOSE_PROJECT_NAME=ramascene
DJANGO_SETTINGS_MODULE=ramasceneMasterProject.config.production
DEBUG=False
SECRET_KEY=
HOST=
DATABASES_DEFAULT_NAME=db.sqlite3
DATASETS_DIR=
DATASETS_VERSION=v4

# Celery broker, e.g. amqp://USER:PASSWORD@message_broker:5672/VHOST
BROKER_URL=
RABBITMQ_VHOST=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Maximum number of calculation jobs queued or running at once (default 50)
RAMASCENE_MAX_ACTIVE_JOBS=50
