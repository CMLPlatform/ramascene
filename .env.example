# Copy to .env and fill in. docker compose reads .env from this directory.
# .env is not tracked; keep real values out of git.

# Required
SECRET_KEY=
# the folder name under datasets/, e.g. v3 or v4
DATASETS_VERSION=

# Optional (defaults shown)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
DEBUG=false
DJANGO_SETTINGS_MODULE=ramasceneMasterProject.config.production
DATABASE_NAME=ramascene.db
HOST=www.ramascene.eu
PROTOCOL=http
WS_HOST=www.ramascene.eu
WS_PROTOCOL=ws
